#!/usr/bin/env bash
# aicode — launch OpenCode with $PWD as the ai_code MCP sandbox root.
#
# Usage:
#   cd <project-to-analyze>
#   aicode               # opens OpenCode TUI here, AICODE_ROOT=$PWD
#   aicode <args...>     # extra args are forwarded to `opencode`
#
# Override the auto-detected root:
#   AICODE_ROOT=/some/other/path aicode
#
# Designed as a one-command CLI: cd into a project, run one command, done.
# No per-project edits to opencode.json required.

set -euo pipefail

resolve_aicode_home() {
  local source="${BASH_SOURCE[0]}"
  local dir

  while [ -h "$source" ]; do
    dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd -P)"
    source="$(readlink "$source")"
    case "$source" in
      /*) ;;
      *) source="$dir/$source" ;;
    esac
  done

  cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd -P
}

CODETRAIL_HOME="$(resolve_aicode_home)" || {
  echo "[aicode] cannot resolve CodeTrail checkout path" >&2
  exit 2
}

# --- 子指令路由:web / attach -----------------------------------------------
# 子指令必須是「第一個位置參數且精確等於 web / attach」才觸發新路徑。
# 其他情況(無參數、-m、專案路徑等)完全維持現行 standalone TUI 行為。
# 注意:想對名為 web/attach 的子目錄開 TUI,請用 `aicode ./web`(不會精確匹配)。
SUBCMD=""
case "${1:-}" in
  attach)
    # attach 是純 client:不需要 venv / 沙箱 root 檢查 / MCP launcher。
    # 保持薄,只做「預設 URL + 參數原樣轉發 opencode attach」。
    shift
    if [ "$#" -ge 1 ] && [ "${1:0:1}" != "-" ]; then
      ATTACH_URL="$1"
      shift
    else
      ATTACH_URL="http://127.0.0.1:${AICODE_WEB_PORT:-4096}"
    fi
    if ! command -v opencode >/dev/null 2>&1; then
      echo "[aicode] 'opencode' not found in PATH — install with: npm install -g opencode-ai@latest" >&2
      exit 127
    fi
    echo "[aicode] attach → $ATTACH_URL" >&2
    exec opencode attach "$ATTACH_URL" "$@"
    ;;
  web)
    # web backend 沿用 aicode 全部既有前置(沙箱 root 檢查、MCP launcher、
    # ctx safety、AICODE_MODEL 解析、AI_CODE_* 透傳)。web 專屬處理(能力偵測、
    # port/hostname、安全硬規則、exec opencode web)在腳本結尾、現有 -m 解析
    # 之前分支。這裡只標記子指令並 shift 掉,讓後續前置看到的是 web 參數。
    SUBCMD="web"
    shift
    ;;
esac

# Allow explicit override via env, else use cwd (canonicalised).
if [ -n "${AICODE_ROOT:-}" ]; then
  ROOT="$AICODE_ROOT"
else
  ROOT="$(pwd -P)"
fi

# Resolve to absolute, canonical path (handles symlinks, ~, etc.).
ROOT="$(cd "$ROOT" 2>/dev/null && pwd -P)" || {
  echo "[aicode] root is not a readable directory: $ROOT" >&2
  exit 2
}

# Refuse roots that are almost certainly a mistake — these would expose
# the entire home / filesystem to the MCP sandbox.
case "$ROOT" in
  /)
    echo "[aicode] refusing AICODE_ROOT=/ (would expose entire filesystem)" >&2
    exit 2
    ;;
  "$HOME")
    echo "[aicode] refusing AICODE_ROOT=\$HOME ($HOME)" >&2
    echo "         cd into a specific project directory first." >&2
    exit 2
    ;;
esac

# AICODE_ROOT override 時,先 cd 到該 root 再做其餘所有事:MCP wrapper 的
# 放置位置、preflight、canary 與最後 exec 的 OpenCode 才會看到同一個專案。
# 不 cd 的話 OpenCode 仍以原 cwd 當專案,載入另一個目錄的設定與
# instructions,前面驗過的保證全部對不上。ROOT == cwd(未 override)時是 no-op。
cd "$ROOT" || {
  echo "[aicode] cannot cd into AICODE_ROOT: $ROOT" >&2
  exit 2
}

resolve_opencode_mcp_root() {
  if command -v git >/dev/null 2>&1; then
    git rev-parse --show-toplevel 2>/dev/null && return
  fi
  pwd -P
}

OPENCODE_MCP_ROOT="$(resolve_opencode_mcp_root)" || {
  echo "[aicode] cannot resolve OpenCode MCP wrapper root" >&2
  exit 2
}

prepare_opencode_mcp_wrapper() {
  local opencode_dir="$OPENCODE_MCP_ROOT/.opencode"
  local wrapper="$opencode_dir/run-codetrail-mcp"
  local tmp="$wrapper.tmp.$$"

  mkdir -p "$opencode_dir" || {
    echo "[aicode] cannot create $opencode_dir for the OpenCode MCP wrapper" >&2
    exit 2
  }

  if [ -e "$wrapper" ] && ! grep -q "generated by CodeTrail aicode" "$wrapper" 2>/dev/null; then
    if [ ! -x "$wrapper" ]; then
      echo "[aicode] WARNING: custom MCP wrapper exists but is not executable: $wrapper" >&2
    fi
    return
  fi

  cat > "$tmp" <<EOF
#!/usr/bin/env bash
# generated by CodeTrail aicode; safe to regenerate
set -euo pipefail

if [ -z "\${AICODE_ROOT:-}" ]; then
  AICODE_ROOT="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")/.." && pwd -P)"
  export AICODE_ROOT
fi

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$CODETRAIL_HOME/mcp_server.py"
fi

exec python "$CODETRAIL_HOME/mcp_server.py"
EOF
  chmod 700 "$tmp"
  mv "$tmp" "$wrapper"
}

if ! command -v opencode >/dev/null 2>&1; then
  echo "[aicode] 'opencode' not found in PATH — install with: npm install -g opencode-ai@latest" >&2
  exit 127
fi

# OpenCode 1.18.x 的 experimental Code Mode 會把原本直接暴露的
# codetrail_* MCP tools 收進單一 `execute` tool。CodeTrail 現行 permission
# template、AGENTS schema anchor 與 model canary 都以 direct tools 為契約；
# 放行會直到較晚的 canary 才以「沒有 codetrail_list_dir event」失敗。
# 顯式 opt-in 直接 fail-loud；未顯式設定時固定 false，避免較寬的
# OPENCODE_EXPERIMENTAL=true 意外改掉 MCP 協定，同時不影響其他實驗功能。
OPENCODE_CODE_MODE_VALUE="${OPENCODE_EXPERIMENTAL_CODE_MODE:-}"
case "${OPENCODE_CODE_MODE_VALUE,,}" in
  1|true|yes|on)
    echo "[aicode] refusing OpenCode experimental Code Mode: CodeTrail requires direct codetrail_* MCP tools." >&2
    echo "[aicode] supported client contract is OpenCode >=1.17.0,<2.0.0." >&2
    echo "[aicode] OpenCode V2 uses mcp.servers.codetrail plus different codemode:false, disabled, and execution timeout semantics; Code Mode is outside this specification." >&2
    echo "[aicode] set OPENCODE_EXPERIMENTAL_CODE_MODE=false and retry." >&2
    exit 2
    ;;
esac
export OPENCODE_EXPERIMENTAL_CODE_MODE=false

# AICODE_COMPACTION_STATE only exists for the private compaction-quality eval,
# which points the plugin at a throw-away ownership state bound to its own
# temporary config.  A value left over in the caller's shell would make the
# runtime plugin read a different (or missing) state than every diagnostic here
# does — contract check, doctor and the canary all read the real one.  Strip it.
unset AICODE_COMPACTION_STATE

if command -v python3 >/dev/null 2>&1; then
  PYBIN=python3
elif command -v python >/dev/null 2>&1; then
  PYBIN=python
else
  PYBIN=""
fi

if [ -z "$PYBIN" ]; then
  echo "[aicode] python3/python not found in PATH — required for main-model resolution and ctx safety check." >&2
  exit 2
fi

# Direct native-tool compatibility is the first OpenCode contract gate.  It
# must run before generating the project wrapper or invoking any --fix writer,
# MCP server, or model canary; otherwise an incompatible V2/Code Mode client
# could mutate V1 config and only fail much later.  `aicode attach` already
# exec'd above and deliberately remains a thin client.
DIRECT_CONTRACT_CHECK="$CODETRAIL_HOME/scripts/opencode_direct_contract.py"
if [ ! -f "$DIRECT_CONTRACT_CHECK" ]; then
  echo "[aicode] missing required direct-tool contract check: $DIRECT_CONTRACT_CHECK" >&2
  exit 2
fi
DIRECT_CONTRACT_OUT=""
if ! DIRECT_CONTRACT_OUT="$("$PYBIN" "$DIRECT_CONTRACT_CHECK" --root "$ROOT" --print-version-env)"; then
  printf '%s\n' "$DIRECT_CONTRACT_OUT"
  echo "[aicode] OpenCode direct-tool contract refused to start (see [direct-contract] above)." >&2
  exit 2
fi
printf '%s\n' "$DIRECT_CONTRACT_OUT" | grep -v '^AICODE_OPENCODE_VERSION=' || true
# Hand the measured OpenCode version to the compaction plugin.  The public
# plugin/SDK API has no "currently running version" field (`Session.version` is
# the version that *created* the session), so this preflight is the only place
# that can gate compaction on it.  Only an exact `MAJOR.MINOR.PATCH` value is
# accepted; anything else is dropped rather than exported.
OPENCODE_VERSION_LINE="$(printf '%s\n' "$DIRECT_CONTRACT_OUT" | grep '^AICODE_OPENCODE_VERSION=' | head -n 1 || true)"
if [[ "$OPENCODE_VERSION_LINE" =~ ^AICODE_OPENCODE_VERSION=([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
  export AICODE_OPENCODE_VERSION="${BASH_REMATCH[1]}"
else
  unset AICODE_OPENCODE_VERSION
fi

# This is the first launcher write.  Keep it after the compatibility gate.
prepare_opencode_mcp_wrapper

# Resolve the same deployment profile used by launchers, doctor, status, and
# preflight.  NUL-delimited KEY=VALUE records are imported one-by-one; profile
# JSON is never sourced or eval'd as shell code.  Main model stays excluded
# here because the existing -m/--model resolver below owns CLI precedence.
if [ -f "$CODETRAIL_HOME/deployment_profile.py" ]; then
  if ! "$PYBIN" "$CODETRAIL_HOME/deployment_profile.py" validate >/dev/null; then
    echo "[aicode] deployment profile validation refused to start." >&2
    exit 2
  fi
  PROFILE_ENV=()
  mapfile -d '' -t PROFILE_ENV < <(
    "$PYBIN" "$CODETRAIL_HOME/deployment_profile.py" env --null
  )
  for assignment in "${PROFILE_ENV[@]}"; do
    case "${assignment%%=*}" in
      AICODE_LLAMA_BASE_URL|AICODE_LLAMA_EMBED_BASE_URL|AICODE_LLAMA_RERANK_BASE_URL|AICODE_LLAMA_VL_BASE_URL|AICODE_EMBED_MODEL|AICODE_RERANK_MODEL|AICODE_VL_MODEL|AICODE_VL_MMPROJ|AICODE_EFFECTIVE_PROFILE)
        export "$assignment"
        ;;
      *)
        echo "[aicode] deployment profile emitted an unsupported environment key." >&2
        exit 2
        ;;
    esac
  done
  echo "[aicode] deployment profile=${AICODE_EFFECTIVE_PROFILE:-defaults}"
fi

# 主模型解析:env > -m/--model arg > deployment profile/local override >
# OPENCODE_CONFIG / ~/.config/opencode/opencode.json。全部找不到、是 placeholder、
# 或被指到外部 provider (openai/、ollama/ 等) 時,
# resolve_main_model.py 會印 fail-loud 訊息到 stderr 並 exit 2。CodeTrail 不內建 /
# 不 fallback 任何預設主模型 — 使用者必須先下載一顆 GGUF 並啟動 llama-server。
if ! RESOLVED_MAIN_MODEL="$("$PYBIN" "$CODETRAIL_HOME/scripts/resolve_main_model.py" "$@")"; then
  exit 2
fi
# resolve_main_model.py 已經 strip 掉 custom provider prefix, 這裡拿到的是 bare
# model name (或 GGUF 路徑)。把它寫回 AICODE_MODEL, 讓 ctx_safety_check /
# mcp_server / 子行程拿到同一顆。
export AICODE_MODEL="$RESOLVED_MAIN_MODEL"

# 主模型只傳遞一個 n_ctx。正常情況從 server /props 觀測實值；server 暫時不可讀時
# 使用 deployment profile 的 main.ctx。AICODE_N_CTX 可作單次明確 override，後面的
# safety gate 仍會確認它不超過實際 server。
if [ -z "${AICODE_N_CTX:-}" ]; then
  if RESOLVED_CTX="$("$PYBIN" "$CODETRAIL_HOME/scripts/resolve_server_ctx.py")" && [ -n "$RESOLVED_CTX" ]; then
    export AICODE_N_CTX="$RESOLVED_CTX"
    echo "[aicode] n_ctx=$RESOLVED_CTX (from main server)"
  elif CONFIGURED_CTX="$("$PYBIN" "$CODETRAIL_HOME/deployment_profile.py" get main ctx)" && [ -n "$CONFIGURED_CTX" ]; then
    export AICODE_N_CTX="$CONFIGURED_CTX"
    echo "[aicode] n_ctx=$CONFIGURED_CTX (from deployment profile; server 尚無法觀測)"
  fi
else
  echo "[aicode] n_ctx=${AICODE_N_CTX} (from AICODE_N_CTX)"
fi
if [ -n "${AICODE_DYNAMIC_NUM_CTX_MAX:-}" ]; then
  echo "[aicode] WARNING: AICODE_DYNAMIC_NUM_CTX_MAX 已 deprecated 且不再是另一個 max；請移除。" >&2
fi
if [ -n "${AICODE_NUM_CTX:-}" ]; then
  echo "[aicode] WARNING: AICODE_NUM_CTX 已 deprecated；請移除並只設定主 n_ctx。" >&2
fi

# 容量閘:確認上面決定的 CodeTrail ctx budget 不會「超過」server 真實 n_ctx
# (超過會截斷 prompt)。正常自動跟隨時 requested == server、直接放行;會擋下的只有
# 設定值與 server 實值不相容的情況。
# ctx_safety_check.py 讀 server /props (預設 8080);server 沒啟動 / 不可連的 UNKNOWN
# 情況 exit 0 只 warn,不擋 CI / 遠端。
if [ -f "$CODETRAIL_HOME/scripts/ctx_safety_check.py" ]; then
  if ! "$PYBIN" "$CODETRAIL_HOME/scripts/ctx_safety_check.py"; then
    echo "[aicode] ctx safety check refused to start (see [ctx-safety] above)." >&2
    exit 2
  fi
fi

if [ -f "$CODETRAIL_HOME/scripts/opencode_ctx_check.py" ]; then
  # limit.context 是主 n_ctx 的 client-side 鏡像；只改 active model 的這一欄，
  # 原子寫入並保留備份，讓使用者不必維護第二個數字。
  if ! "$PYBIN" "$CODETRAIL_HOME/scripts/opencode_ctx_check.py" --fix "$@"; then
    echo "[aicode] OpenCode n_ctx sync refused to start (see [ctx-align] above)." >&2
    exit 2
  fi
fi

if [ -f "$CODETRAIL_HOME/scripts/opencode_mcp_timeout_check.py" ]; then
  # 這是可安全自動對齊的單一 client 欄位：只改既有
  # mcp.codetrail.timeout，保留其他 OpenCode 設定並留下備份。這讓舊使用者
  # git pull 後第一次執行 aicode 就修好，不必逐台手動改全域設定。
  if ! "$PYBIN" "$CODETRAIL_HOME/scripts/opencode_mcp_timeout_check.py" --fix; then
    echo "[aicode] OpenCode MCP timeout sync refused to start (see [mcp-timeout] above)." >&2
    exit 2
  fi
fi

if [ -f "$CODETRAIL_HOME/scripts/opencode_contract_check.py" ]; then
  # 舊安裝 git pull 後的自動遷移:record_lesson 等寫入工具的 ask 核准閘與
  # lessons 的 instructions 項都在全域 opencode.json。沒補上的話,新工具會被
  # 舊的 codetrail_* allow wildcard 直接放行(繞過人工核准),lessons.md
  # render 了也不會被載入。只補缺少的鍵、使用者設過的值一律尊重、有備份。
  if ! "$PYBIN" "$CODETRAIL_HOME/scripts/opencode_contract_check.py" --fix; then
    echo "[aicode] OpenCode contract sync refused to start (see [oc-contract] above)." >&2
    exit 2
  fi
fi

if [ -f "$CODETRAIL_HOME/scripts/lessons_check.py" ]; then
  # session start 注入 lessons(行為教訓):把 active lessons render 成
  # $ROOT/.codetrail/lessons.md(OpenCode 經 opencode.json instructions 載入),
  # 並提示已過 review_by 的待複審清單。store 損壞 / 超過上限會 fail-loud。
  if ! "$PYBIN" "$CODETRAIL_HOME/scripts/lessons_check.py" --root "$ROOT"; then
    echo "[aicode] lessons check refused to start (see [lessons] above)." >&2
    exit 2
  fi
fi

if [ -f "$CODETRAIL_HOME/scripts/required_model_servers_check.py" ]; then
  if ! "$PYBIN" "$CODETRAIL_HOME/scripts/required_model_servers_check.py"; then
    echo "[aicode] required model server preflight refused to start (see [model-preflight] above)." >&2
    exit 2
  fi
fi

export AICODE_ROOT="$ROOT"
echo "[aicode] AICODE_ROOT=$AICODE_ROOT"

# MCP / tool-call health gate:
#   1) 每次都直接走 initialize → tools/list → list_dir，確認 server 真正暴露
#      完整 19-tool contract，而不是相信模型對自身工具的文字描述。
#   2) explicit fresh `opencode run --format json` 必須產生 completed 的
#      codetrail_list_dir event（硬 gate，可重試一次）。通過後另跑一次未點名
#      工具的 implicit routing 診斷；optimal/suboptimal/fail/timeout 都不擋啟動。
#      兩條 lane 依 model/config/template/root/protocol 指紋分開快取。
# attach 是薄 client，前面已直接 exec，不會重跑 backend canary；standalone TUI 與
# web backend 都會走這道 gate。`--` 後原樣交給 Python，只掃描 -m/--model，
# 不會消耗或改寫稍後要轉發給 OpenCode 的參數。
TOOL_CANARY="$CODETRAIL_HOME/scripts/tool_call_canary.py"
if [ ! -f "$TOOL_CANARY" ]; then
  echo "[aicode] missing required tool-call canary: $TOOL_CANARY" >&2
  exit 2
fi
if ! "$PYBIN" "$TOOL_CANARY" --root "$AICODE_ROOT" -- "$@"; then
  echo "[aicode] CodeTrail tool health check refused to start (see [tool-health] above)." >&2
  exit 2
fi

# 主模型的 server、CodeTrail budget 與 OpenCode client 現在共用同一個 n_ctx；
# embedding/reranker/VL 是獨立 server 的內部 ctx，不混入這個使用者設定。
echo "[aicode] AICODE_MODEL=${AICODE_MODEL}"
if [ -n "${AICODE_N_CTX:-}" ]; then
  echo "[aicode] n_ctx=${AICODE_N_CTX}"
fi
if [ -n "${AICODE_RESERVED_OUTPUT_TOKENS:-}" ]; then
  echo "[aicode] AICODE_RESERVED_OUTPUT_TOKENS=${AICODE_RESERVED_OUTPUT_TOKENS}"
fi
if [ -n "${AICODE_LLAMA_BASE_URL:-}" ]; then
  echo "[aicode] AICODE_LLAMA_BASE_URL=${AICODE_LLAMA_BASE_URL} (主 LLM server)"
fi

# 目前的壓縮模式(OpenCode 什麼時候把長對話換成一段摘要)。模式只在 OpenCode
# 啟動時生效、選擇記在 ~/.config/codetrail/compaction.json,所以不印的話使用者
# 整段 session 都不知道自己在用哪一個 —— codetrail / manual 還在測試階段,更該
# 講。純讀取、fail-open:那支腳本自己吞掉所有例外並永遠 exit 0,`|| true` 是第
# 二道保險。這一行是資訊不是閘,不得擋住啟動。
COMPACTION_STATUS="$CODETRAIL_HOME/scripts/compaction_status.py"
if [ -f "$COMPACTION_STATUS" ]; then
  "$PYBIN" "$COMPACTION_STATUS" --prefix '[aicode]' || true
fi

echo "[aicode] NOTE: 主 n_ctx 只需用 ./set_config.sh 設一次；改完重啟 server。"
echo "         CodeTrail budget 與 OpenCode active model limit.context 會自動跟隨。"
echo "         Check loaded model with: curl -s \${AICODE_LLAMA_BASE_URL:-http://localhost:8080}/props"
echo "         CodeTrail context overflow attempts are logged to .codetrail/context_metrics.jsonl"

# Pitfall warning: /models in TUI 跟 CodeTrail MCP 的 AICODE_MODEL 是兩條獨立
# 設定。換模型靠重啟 server (load 新 GGUF) + 重啟 aicode wrapper。
echo "[aicode] TIP: 換模型請先停掉 llama-server, 換 GGUF 重啟, 再改 AICODE_MODEL 重啟 aicode。"
echo "         在 TUI 內按 /models 只會切 OpenCode 那邊的 model id,不會 reload server,"
echo "         也不會通知 CodeTrail MCP — 兩邊不同步會錯亂。"

# Point new users at the health check so they don't have to discover it via README.
echo "[aicode] TIP: 設定有疑慮時可跑 \`AICODE_MODEL=${AICODE_MODEL} python scripts/doctor.py\` 做健檢。"

# OpenCode 那邊吃 <custom-provider>/<model> 形式的 model id (provider 名由使用者
# 在 opencode.json 自己取)。CodeTrail wrapper 沒辦法 / 也不該替使用者決定 provider
# 取名是什麼,所以這裡:
#   - 若使用者傳了 -m / --model:原樣轉發給 opencode (使用者負責格式正確)
#   - 若沒傳:不主動加 --model;讓 opencode 自己讀 opencode.json 的 "model" 欄位
# AICODE_MODEL (bare name) 仍用於 CodeTrail MCP 本體, 跟 OpenCode TUI 顯示的
# 可能形式不同但語意一致 (provider/ 後面那段)。

if [ "${SUBCMD:-}" = "web" ]; then
  # ---- aicode web: 帶 CodeTrail MCP 的 OpenCode web backend ----------------
  # 能力偵測:確認這個 opencode 真的支援 web 子指令。
  # 不能只看 exit code —— yargs 對 `--help` 短路,`opencode <任何字> --help`
  # 一律 exit 0(舊版會把 web 當成專案 positional)。因此額外要求輸出含 web
  # 指令自己的 synopsis 行(`opencode web`),代表 yargs 真的路由到 web。
  web_help_ok=1
  if ! web_help_out="$(opencode web --help 2>&1)"; then
    web_help_ok=0
  elif ! printf '%s\n' "$web_help_out" | grep -qE '^opencode web([[:space:]]|$)'; then
    web_help_ok=0
  fi
  if [ "$web_help_ok" -ne 1 ]; then
    echo "[aicode] 這個 opencode 不支援 'web' 子指令(版本太舊)。" >&2
    echo "[aicode] 升級後再試:npm install -g opencode-ai@latest" >&2
    echo "[aicode] web backend 需要 opencode 內建的 headless server + 網頁介面。" >&2
    exit 2
  fi

  # port:讀 AICODE_WEB_PORT,否則固定 4096(刻意固定,方便 attach;不沿用上游
  # 隨機 port)。hostname:預設 127.0.0.1。使用者可在轉發 args 覆寫 --port /
  # --hostname;這裡解析出來以套預設、做安全檢查,其餘 args 原樣轉發。
  WEB_PORT="${AICODE_WEB_PORT:-4096}"
  WEB_HOSTNAME="127.0.0.1"
  WEB_MDNS=0
  WEB_PASSTHROUGH=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --port)
        if [ "$#" -lt 2 ] || [[ "$2" == -* ]]; then
          echo "[aicode] --port 需要一個值。" >&2
          exit 2
        fi
        WEB_PORT="$2"
        shift 2
        ;;
      --port=*)
        WEB_PORT="${1#--port=}"
        if [ -z "$WEB_PORT" ]; then
          echo "[aicode] --port 需要一個值。" >&2
          exit 2
        fi
        shift
        ;;
      --hostname)
        if [ "$#" -lt 2 ] || [[ "$2" == -* ]]; then
          echo "[aicode] --hostname 需要一個值。" >&2
          exit 2
        fi
        WEB_HOSTNAME="$2"
        shift 2
        ;;
      --hostname=*)
        WEB_HOSTNAME="${1#--hostname=}"
        if [ -z "$WEB_HOSTNAME" ]; then
          echo "[aicode] --hostname 需要一個值。" >&2
          exit 2
        fi
        shift
        ;;
      --mdns|--mdns=*)
        # mDNS 會把 hostname 預設翻成 0.0.0.0 並對區網廣播服務;視為非 loopback 暴露。
        # `--mdns=true` 也是 yargs 接受的形式；保守地把任何 --mdns=<value>
        # 都視為啟用，避免 boolean spelling 繞過密碼硬規則。
        WEB_MDNS=1
        WEB_PASSTHROUGH+=("$1")
        shift
        ;;
      *)
        WEB_PASSTHROUGH+=("$1")
        shift
        ;;
    esac
  done

  # 安全硬規則(比上游嚴):hostname 非 loopback,或開了 --mdns 廣播時,
  # 必須已設 OPENCODE_SERVER_PASSWORD —— 未設密碼時 OpenCode server 完全無認證。
  # 唯一例外是 aicode_web 的受限 Tailscale 路徑:hostname 必須同時等於 wrapper
  # 傳入的 AICODE_WEB_TAILSCALE_IP、以及 tailscale CLI 當下回報的本機 IPv4，且
  # 必須落在 Tailscale 的 100.64.0.0/10。這不允許 0.0.0.0、LAN IP 或任意 env
  # 值繞過密碼硬規則；backend 只 listen 在 Tailscale virtual interface。
  WEB_LOCAL=0
  case "$WEB_HOSTNAME" in
    127.0.0.1|localhost|::1)
      WEB_LOCAL=1
      ;;
  esac

  is_tailscale_ipv4() {
    local ip="$1" a b c d
    [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    IFS=. read -r a b c d <<<"$ip"
    (( 10#$a == 100 && 10#$b >= 64 && 10#$b <= 127 && \
       10#$c >= 0 && 10#$c <= 255 && 10#$d >= 0 && 10#$d <= 255 ))
  }

  WEB_TAILSCALE_VERIFIED=0
  if [ "$WEB_LOCAL" -ne 1 ] && [ "$WEB_MDNS" -ne 1 ] && \
     [ -n "${AICODE_WEB_TAILSCALE_IP:-}" ] && \
     [ "$WEB_HOSTNAME" = "$AICODE_WEB_TAILSCALE_IP" ] && \
     is_tailscale_ipv4 "$WEB_HOSTNAME" && command -v tailscale >/dev/null 2>&1; then
    while IFS= read -r current_ts_ip; do
      if [ "$current_ts_ip" = "$WEB_HOSTNAME" ]; then
        WEB_TAILSCALE_VERIFIED=1
        break
      fi
    done < <(tailscale ip -4 2>/dev/null || true)
  fi

  if [ "$WEB_LOCAL" -ne 1 ] || [ "$WEB_MDNS" -eq 1 ]; then
    if [ -z "${OPENCODE_SERVER_PASSWORD:-}" ] && [ "$WEB_TAILSCALE_VERIFIED" -ne 1 ]; then
      WEB_WHY="hostname=$WEB_HOSTNAME"
      if [ "$WEB_MDNS" -eq 1 ]; then
        WEB_WHY="$WEB_WHY 且開啟 --mdns 廣播"
      fi
      echo "[aicode] 拒絕啟動:$WEB_WHY 會把 web backend 暴露到 loopback 以外," >&2
      echo "[aicode] 但未設定 OPENCODE_SERVER_PASSWORD —— 未設密碼時 OpenCode server 完全無認證。" >&2
      echo "[aicode] 擇一處理:" >&2
      echo "[aicode]   1) 只在本機用:aicode web(預設 127.0.0.1、不要 --mdns)" >&2
      echo "[aicode]   2) A/B 機已加入同一 tailnet:改用 aicode_web(只綁 Tailscale IP)" >&2
      echo "[aicode]   3) 要對其他可信內網暴露:先 export OPENCODE_SERVER_PASSWORD=<強密碼> 再啟動" >&2
      echo "[aicode] 切勿把 0.0.0.0 綁到可信內網以外的網卡。" >&2
      exit 2
    fi
  fi

  if [ "${AICODE_PREFLIGHT_ONLY:-0}" = "1" ]; then
    # aicode_web 的前景預檢模式:全部前置(profile、主模型、n_ctx 閘、OpenCode
    # 同步、附屬 server、tool canary、web 能力偵測與 bind 安全規則)已通過,
    # 到此為止、不啟動 OpenCode;背景 pane 會用同一組檢查再走一次(冪等,
    # canary 命中指紋快取)。
    echo "[aicode] preflight-only:檢查全部通過(未啟動 OpenCode)。"
    exit 0
  fi

  echo "[aicode] web backend → http://$WEB_HOSTNAME:$WEB_PORT"
  echo "[aicode] 🧪 web 模式為實驗功能(開發中);要穩定請用 standalone TUI(直接 aicode)。"
  if [ "$WEB_TAILSCALE_VERIFIED" -eq 1 ]; then
    echo "[aicode] 已驗證並只綁本機 Tailscale IPv4；不會 listen 在 LAN / 公網介面。"
    echo "[aicode] 存取邊界是 tailnet ACL：只有 ACL 允許連到這台 A 機的裝置可開啟。"
  elif [ "$WEB_LOCAL" -eq 1 ] && [ "$WEB_MDNS" -ne 1 ]; then
    echo "[aicode] 綁 loopback。有桌面的話瀏覽器會自動開;若這台是沒有桌面的 server,從你自己的電腦:"
    echo "[aicode]   A/B 機有 Tailscale:Ctrl-C 後改跑 aicode_web(自動印 B 機網址)"
    echo "[aicode]   ssh -N -L $WEB_PORT:127.0.0.1:$WEB_PORT <你的帳號>@<此 server>"
    echo "[aicode]   再用本機瀏覽器開 http://127.0.0.1:$WEB_PORT。另開終端 \`aicode attach\` 可接 TUI。"
  else
    echo "[aicode] 已設 OPENCODE_SERVER_PASSWORD;非 loopback 暴露請確認只在可信內網/VPN。"
  fi
  echo "[aicode] 首頁即 session 清單,點任一 session 續問;Ctrl-C 停止 backend。"
  echo "[aicode] ⚠️ 沙箱鎖在這個專案;web UI『切換資料夾』對 CodeTrail 無效,請無視(換專案=另起 backend)。"

  exec opencode web --port "$WEB_PORT" --hostname "$WEB_HOSTNAME" "${WEB_PASSTHROUGH[@]}"
fi

OPENCODE_ARGS=()
USER_PASSED_MODEL=0
USER_MODEL_VALUE=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -m|--model)
      USER_PASSED_MODEL=1
      flag="$1"
      if [ "$#" -lt 2 ] || [[ "$2" == -* ]]; then
        echo "[aicode] $flag requires a model value." >&2
        exit 2
      fi
      USER_MODEL_VALUE="$2"
      OPENCODE_ARGS+=("$flag" "$2")
      shift 2
      ;;
    -m=*)
      USER_PASSED_MODEL=1
      val="${1#-m=}"
      if [ -z "$val" ]; then
        echo "[aicode] -m requires a model value." >&2
        exit 2
      fi
      USER_MODEL_VALUE="$val"
      OPENCODE_ARGS+=("$1")
      shift
      ;;
    --model=*)
      USER_PASSED_MODEL=1
      val="${1#--model=}"
      if [ -z "$val" ]; then
        echo "[aicode] --model requires a model value." >&2
        exit 2
      fi
      USER_MODEL_VALUE="$val"
      OPENCODE_ARGS+=("$1")
      shift
      ;;
    *)
      OPENCODE_ARGS+=("$1")
      shift
      ;;
  esac
done

if [ "$USER_PASSED_MODEL" -eq 1 ]; then
  echo "[aicode] OpenCode --model=$USER_MODEL_VALUE (使用者傳入,原樣轉發)"
else
  echo "[aicode] 沒有 -m;OpenCode 將自己讀 opencode.json 的 \"model\" 欄位。"
  echo "         若你要明確指定 provider,請用 -m <provider>/<model> 或在 opencode.json 設好。"
fi

if [ "${AICODE_PREFLIGHT_ONLY:-0}" = "1" ]; then
  echo "[aicode] preflight-only:檢查全部通過(未啟動 OpenCode)。"
  exit 0
fi

# OpenCode TUI 一啟動就接管整個畫面,上面所有預檢/修復訊息會瞬間被蓋掉。
# 給使用者幾秒看完再進去。倒數只在輸出是終端機時做:被導向檔案或在測試裡
# 用 pipe 收 stdout 時直接啟動(否則每次呼叫都白等這幾秒)。
# AICODE_LAUNCH_DELAY=0 可關掉。
launch_delay="${AICODE_LAUNCH_DELAY:-3}"
case "$launch_delay" in
  ''|*[!0-9]*) launch_delay=3 ;;
  # 全是數字還不夠:bash 算術把前導零當八進位。`08` 通得過下面的 -gt
  # (test 用的是另一個 parser),再減一就以 "value too great for base" 失敗 ——
  # 而這支腳本是 set -e,於是 wrapper 在 exec opencode 之前就結束;`010` 不會
  # 爆,但安靜地倒數 8 秒。10# 強制十進位。
  *) launch_delay=$((10#$launch_delay)) ;;
esac
if [ -t 1 ] && [ "$launch_delay" -gt 0 ]; then
  while [ "$launch_delay" -gt 0 ]; do
    printf '\r[aicode] 檢查完成,OpenCode %d 秒後啟動(Ctrl-C 取消)… ' "$launch_delay"
    sleep 1
    launch_delay=$((launch_delay - 1))
  done
  printf '\r[aicode] 檢查完成,OpenCode 啟動中…                    \n'
fi

exec opencode "${OPENCODE_ARGS[@]}"
