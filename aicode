#!/usr/bin/env bash
# aicode — CodeTrail 的**唯一**使用者入口。
#
#   cd <要分析的專案>
#   aicode                 # 在這裡開 CodeTrail 的全螢幕 TUI
#   aicode -c              # 接續這個專案最近一次的對話
#   aicode --session <id>  # 接續指定的對話
#
# 這支腳本刻意只做四件 Python 做不了或做起來很難看的事:
#   1. 找到 CodeTrail 的 checkout(自己可能是一個 symlink);
#   2. 找到 python3;
#   3. 拒絕沒有終端機的環境(TUI 會接管整個畫面,pipe 過去只會得到控制碼);
#   4. exec 客戶端。
#
# 其餘全部在 Python 裡:profile 驗證、主模型解析、n_ctx 觀測、ctx 安全閘、
# lessons render、附屬 server 檢查、工具健檢。結果以參數交給 Engine 與 MCP,
# **不經環境** —— 殼層裡殘留的任何 AICODE_* / AI_CODE_* / CODETRAIL_* 對這一次
# 啟動都無效(那是跨 branch 混用的真正機制)。
#
# 沙箱 root 一律是 $PWD。沒有 --root、沒有位置參數、沒有 AICODE_ROOT。

set -euo pipefail

resolve_aicode_home() {
  local source="${BASH_SOURCE[0]}"
  local dir

  while [ -h "$source" ]; do
    dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd -P)"
    source="$(readlink "$source")"
    case "$source" in
      /*) ;;
      *) source="$dir/$source" ;;
    esac
  done

  cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd -P
}

CHECKOUT="$(resolve_aicode_home)" || {
  echo "[aicode] cannot resolve CodeTrail checkout path" >&2
  exit 2
}

if command -v python3 >/dev/null 2>&1; then
  PYBIN=python3
elif command -v python >/dev/null 2>&1; then
  PYBIN=python
else
  echo "[aicode] python3/python not found in PATH — CodeTrail is a Python tool." >&2
  exit 2
fi

CLIENT_ENTRY="$CHECKOUT/codetrail_chat.py"
if [ ! -f "$CLIENT_ENTRY" ]; then
  echo "[aicode] 找不到客戶端進入點:$CLIENT_ENTRY" >&2
  exit 2
fi

# --help 不需要終端機,也不需要跑任何檢查。**由 wrapper 自己印**:客戶端的
# `--help` 會列出 run / status / sessions 這些**內部**入口(canary / eval / doctor 用),
# 而 aicode 底下它們是被拒絕的 —— 列出來只會請使用者去試一個會被打回的東西。
for arg in "$@"; do
  if [ "$arg" = "-h" ] || [ "$arg" = "--help" ]; then
    cat <<EOF
用法: aicode [-c | --continue] [--session <id>]

  cd <要分析的專案>
  aicode                 在這裡開 CodeTrail 的全螢幕 TUI
  aicode -c              接續這個專案最近一次的對話
  aicode --session <id>  接續指定的對話

沙箱 root 一律是目前目錄。主模型、端點與 n_ctx 只來自
~/.config/codetrail/{deployment,models}.json —— 換模型或 n_ctx 就重跑
./set_config.sh 再重啟 server。權限、壓縮模式與其餘開關在
~/.config/codetrail/client.json。

要在腳本裡問一題(headless、JSON 事件流):
  python3 $CLIENT_ENTRY run "<問題>" --format json
EOF
    exit 0
  fi
done

# 使用者入口只有這三個旗標。`codetrail_chat.py` 底下還有 run / status / sessions
# 這些**內部**入口(canary / eval / doctor 用),它們不跑 preflight —— 原樣轉發
# argv 的話,`aicode run "..."` 就變成第二條使用者入口,而且是一條略過 profile
# 驗證、ctx 安全閘與工具健檢的路。白名單在這裡擋掉,錯誤訊息指回真正的入口。
i=1
while [ "$i" -le "$#" ]; do
  eval "arg=\${$i}"
  case "$arg" in
    -c|--continue) ;;
    --session)
      i=$((i + 1))
      if [ "$i" -gt "$#" ]; then
        echo "[aicode] --session 需要一個 session id。" >&2
        exit 2
      fi
      eval "val=\${$i}"
      case "$val" in
        "" )
          echo "[aicode] --session 的值是空的。" >&2
          exit 2
          ;;
        --*)
          echo "[aicode] --session 的值看起來是另一個選項:$val" >&2
          exit 2
          ;;
      esac
      ;;
    --session=*)
      if [ "${arg#--session=}" = "" ]; then
        echo "[aicode] --session= 的值是空的。" >&2
        echo "         空值會被靜默當成「沒有指定」而開一個新對話 —— 那不是你要的。" >&2
        exit 2
      fi
      ;;
    *)
      echo "[aicode] 不認得的參數:$arg" >&2
      echo "         aicode 只接受:-c/--continue、--session <id>、-h/--help。" >&2
      echo "         沙箱 root 一律是目前目錄(cd <專案> && aicode)。" >&2
      echo "         要在腳本裡問一題請用 headless 入口:" >&2
      echo "           $PYBIN $CLIENT_ENTRY run \"<問題>\" --format json" >&2
      exit 2
      ;;
  esac
  i=$((i + 1))
done

# 全螢幕 TUI 需要一個真的終端機。stdin 或 stdout 被導向 / pipe 時**明確拒絕**,
# 不靜默降級成另一種介面 —— 指向 headless 入口,讓腳本使用者拿到能用的東西。
if [ ! -t 0 ] || [ ! -t 1 ]; then
  echo "[aicode] aicode 是全螢幕介面,需要一個終端機(tty)。" >&2
  echo "         這裡的 stdin/stdout 不是終端機(被 pipe / 重導 / 在 cron 裡)。" >&2
  echo "         要在腳本裡問一題請用 headless 入口:" >&2
  echo "           python3 $CLIENT_ENTRY run \"<問題>\" --format json" >&2
  exit 2
fi

# 介面是 Textual。缺套件要在這裡 fail-loud 印出可照打的 pip 指令,不是等
# 客戶端 import 失敗丟一段 traceback。
if ! "$PYBIN" -c "import textual" >/dev/null 2>&1; then
  echo "[aicode] 缺少 textual —— aicode 的終端介面靠它。" >&2
  echo "[aicode] 修復:$PYBIN -m pip install --user \"textual>=8,<9\"" >&2
  echo "[aicode]   (不要加 [syntax] extra:它拉的 tree-sitter 文法與本 repo 釘死的版本衝突)" >&2
  exit 2
fi

exec "$PYBIN" "$CLIENT_ENTRY" "$@"
