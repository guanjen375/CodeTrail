{
  "schema_version": 1,
  "name": "safe-defaults",
  "description": "Backward-compatible CodeTrail llama-server defaults without a hardware claim.",
  "verification": "unverified",
  "hardware": "unspecified",
  "services": {
    "main": {
      "model": null,
      "port": 8080,
      "base_url": "http://localhost:8080",
      "gpu_role": "main",
      "ctx": 65536,
      "batch": null,
      "ubatch": null,
      "parameters": {
        "gpu_layers": 99,
        "jinja": true
      }
    },
    "embedding": {
      "model": "bge-m3",
      "port": 8081,
      "base_url": "http://localhost:8081",
      "gpu_role": "aux",
      "ctx": 8192,
      "batch": 8192,
      "ubatch": 8192,
      "parameters": {
        "gpu_layers": 99,
        "embedding": true,
        "pooling": "cls"
      }
    },
    "reranker": {
      "model": "bge-reranker-v2-m3",
      "port": 8082,
      "base_url": "http://localhost:8082",
      "gpu_role": "aux",
      "ctx": 8192,
      "batch": 8192,
      "ubatch": 8192,
      "parameters": {
        "gpu_layers": 99,
        "embedding": true,
        "pooling": "rank",
        "reranking": true
      }
    },
    "vl": {
      "model": "qwen3.5-9b",
      "mmproj": "qwen3.5-9b-mmproj-f16",
      "port": 8083,
      "base_url": "http://localhost:8083",
      "gpu_role": "aux",
      "ctx": 8192,
      "batch": null,
      "ubatch": null,
      "parameters": {
        "gpu_layers": 99
      }
    }
  }
}
